{
  "_comment": "TEMPLATE ONLY. Copy to rabbitmq-definitions.json (git-ignored) and fill in real password hashes. Generate a hash with: rabbitmqctl hash_password '<password>' (or the HTTP API). Do NOT commit the filled-in file.",
  "users": [
    {
      "name": "admin",
      "password_hash": "REPLACE_WITH_GENERATED_HASH",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "administrator"
    },
    {
      "name": "trades",
      "password_hash": "REPLACE_WITH_GENERATED_HASH",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "consumer"
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "admin",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "trades",
      "vhost": "/",
      "configure": "^$",
      "write": "^(root|trades)$",
      "read": "^(trades|trades-whales|trades-dolphins|trades-octopuses)$"
    }
  ],
  "exchanges": [
    {
      "name": "root",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "trades",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": true,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "trades",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "trades-whales",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "trades-dolphins",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "trades-octopuses",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "root",
      "vhost": "/",
      "destination": "trades",
      "destination_type": "exchange",
      "routing_key": "",
      "arguments": {}
    },
    {
      "source": "trades",
      "vhost": "/",
      "destination": "trades",
      "destination_type": "queue",
      "routing_key": "trades.all",
      "arguments": {}
    },
    {
      "source": "trades",
      "vhost": "/",
      "destination": "trades-whales",
      "destination_type": "queue",
      "routing_key": "trades.whales",
      "arguments": {}
    },
    {
      "source": "trades",
      "vhost": "/",
      "destination": "trades-dolphins",
      "destination_type": "queue",
      "routing_key": "trades.dolphins",
      "arguments": {}
    },
    {
      "source": "trades",
      "vhost": "/",
      "destination": "trades-octopuses",
      "destination_type": "queue",
      "routing_key": "trades.octopuses",
      "arguments": {}
    }
  ]
}
